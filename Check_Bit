#include <stdio.h>

int main() {
    int bits[] = {1, 0, 0,1,0};
    int n = 5;

    int i = 0;

    while (i < n - 1) {
        if (bits[i] == 1) {
            i += 2;
        } else {
            i += 1;
        }
    }

    if (i == n - 1) {
        printf("True, The  First Bit is Single Bit\n");
    } else {
        printf("false, The Last Bit is Double Bit\n");
    }

    return 0;
}
