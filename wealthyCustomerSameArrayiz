#include <stdio.h>

int main() {
    int arr[4][4];
    int max = 0, customer = 0;


    printf("Enter 4x4 matrix values:\n");
    for(int i = 0; i < 4; i++) {
        for(int j = 0; j < 4; j++) {
            scanf("%d", &arr[i][j]);
        }
    }


    for(int i = 0; i < 4; i++) {
        int sum = 0;
        for(int j = 0; j < 4; j++) {
            sum += arr[i][j];
        }

        if(sum > max) {
            max = sum;
            customer = i;
        }

    }


    printf("Wealthiest customer is: %d\n", customer + 1);
    printf("Total wealth: %d\n", max);

    return 0;
}
